# ----------------------------------------------------------------------------
# IIEV Show 2027 website - environment variables (names only; never commit values)
# Copy to .env.local for local development. Set in your host's encrypted
# environment settings for staging/production. See docs/INTEGRATION_SETUP.md.
# ----------------------------------------------------------------------------

# Environment
NEXT_PUBLIC_SITE_URL=            # canonical origin, e.g. https://staging.iievshow.com or https://iievshow.com
SITE_ENV=                        # development | staging | production
ALLOW_INDEXING=                  # "true" ONLY on approved production launch (launch gate). Anything else = noindex
STAGING_BASIC_AUTH=              # staging only: "user:password" for HTTP Basic protection

# Security (required in staging/production)
APP_SECRET=                      # 48+ random bytes (base64). Signs sessions/badge links. Rotating logs everyone out.
APP_ENCRYPTION_KEY=              # exactly 32 bytes base64 (AES-256-GCM for badge tokens & MFA seeds)
CRON_SECRET=                     # random string; Authorization: Bearer <CRON_SECRET> for /api/jobs/run/
ADMIN_SESSION_HOURS=10
TRUSTED_PROXY_HOPS=1             # proxies in front of the app that append X-Forwarded-For (Vercel/nginx = 1)

# MongoDB Atlas
MONGODB_URI=mongodb+srv://web_db_user:ZyiOSeXVp9zhVxax@cluster0.mth1w3w.mongodb.net/      # mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/iiev?retryWrites=true&w=majority
MONGODB_DB=      IIEV Expo                # optional database name override
MONGODB_POOL_SIZE=10
MONGODB_AUTO_INDEX=false         # production builds indexes via `npm run seed`
# web_db_user
# ZyiOSeXVp9zhVxax
# Email (SMTP). Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 + App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=                      # e.g. "IIEV Show <noreply@iievshow.com>" (must be allowed by the provider)
NOTIFY_EMAILS=                   # fallback: two organiser recipients, comma-separated (CMS settings take precedence)
SEND_ACKNOWLEDGEMENTS=true
NOTIFY_ON_VISITOR=false          # also email organisers for every visitor registration

# Google Sheets (service account; share the sheet with the service account email as Editor)
GOOGLE_SHEETS_ID=1xlgR6wuIn74H23sLCHEdfj75h3BHisbG6zUgNpFUmkY
GOOGLE_SERVICE_ACCOUNT_EMAIL=futurextrade-forms@futurex-trade-508809.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_BASE64= 

# Media storage (S3-compatible: AWS S3, Cloudflare R2, DO Spaces...) - required on serverless hosts
S3_ENDPOINT=                     # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=              # public CDN base, e.g. https://media.iievshow.com
MEDIA_CDN_HOST=                  # hostname of S3_PUBLIC_BASE_URL (allows next/image optimisation)

# Analytics & verification (optional; analytics loads only after visitor consent)
NEXT_PUBLIC_GA_ID=               # G-XXXXXXX
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Privacy
PRIVACY_NOTICE_VERSION=draft-2026-10

# Seed script only
ADMIN_EMAIL=
ADMIN_NAME=


# Existing MongoDB Atlas variables — use your real credentials in .env.local
MONGODB_URI=
MONGODB_DB=

